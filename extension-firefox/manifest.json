{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.8.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "StremioHub"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.strem.io/*",
    "https://v3-cinemeta.strem.io/*",
    "https://letterboxd.com/*",
    "https://www.letterboxd.com/*",
    "https://www.imdb.com/*",
    "https://www.themoviedb.org/*",
    "https://www.rottentomatoes.com/*",
    "https://www.metacritic.com/*",
    "https://www.google.com/search*",
    "https://trakt.tv/*",
    "https://*.trakt.tv/*",
    "https://mdblist.com/*",
    "https://api.mdblist.com/*",
    "https://publicmetadb.com/*",
    "*://web.stremio.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://letterboxd.com/film/*",
        "*://www.letterboxd.com/film/*",
        "*://letterboxd.com/*/film/*",
        "*://www.letterboxd.com/*/film/*",
        "*://www.imdb.com/title/*",
        "*://www.themoviedb.org/movie/*",
        "*://www.themoviedb.org/tv/*",
        "*://www.rottentomatoes.com/m/*",
        "*://www.rottentomatoes.com/tv/*",
        "*://www.metacritic.com/movie/*",
        "*://www.metacritic.com/tv/*",
        "*://www.google.com/search*",
        "*://trakt.tv/movies/*",
        "*://trakt.tv/shows/*",
        "*://*.trakt.tv/movies/*",
        "*://*.trakt.tv/shows/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/shared.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://web.stremio.com/*"
      ],
      "js": [
        "stremio-web-enhancer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/stremio-icon.png",
        "fonts/thmanyahsans-Regular.woff2",
        "fonts/thmanyahsans-Bold.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stremiohub-harbor@abadiosa",
      "strict_min_version": "119.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/ABADIOSA/ABADIOSA/main/updates/updates.json"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http: ws: wss:;"
  },
  "commands": {
    "harbor-play-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Harbor: play / pause"
    },
    "harbor-next-episode": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Harbor: next episode"
    },
    "harbor-open-remote": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Harbor: open remote screen"
    }
  }
}
